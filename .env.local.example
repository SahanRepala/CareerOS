# Supabase project credentials (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: a GitHub personal access token (no scopes needed for public repos)
# raises the GitHub API rate limit used by the GitHub Intelligence module.
GITHUB_TOKEN=

# Optional: an Anthropic API key enables AI-generated repository summaries,
# architecture explanations, scores, and resume bullets in GitHub Intelligence.
# Without it, the module falls back to a deterministic, signal-based analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
